# ==============================================================================
# AIRA (Amharic Intelligent Research Assistant) - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env containing real keys to version control.
# ==============================================================================

# Primary LLM Provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback LLM Provider (Groq / OpenRouter)
FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Academic Search APIs (Optional keys for higher rate limits)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=researcher@example.com

# Optional Observability & Tracing (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=aira-research-agent

# Local Storage & Database Paths
DATABASE_URL=sqlite:///./aira.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
PAPERS_DIRECTORY=./data/papers
PROCESSED_DIRECTORY=./data/processed
REPORTS_DIRECTORY=./data/reports

# Agent & Search Limits & Safety Rules
# Counts LangGraph node executions (~5 per tool call); a full multi-paper run needs ~60-100.
MAX_AGENT_STEPS=150
MAX_RETRIES=2
MAX_SEARCH_RESULTS=20
REQUEST_TIMEOUT_SECONDS=30
ACADEMIC_MAX_RETRIES=2
ACADEMIC_INITIAL_BACKOFF_SECONDS=1.0
# Semantic Scholar allows ~1 request/second; requests are spaced by this many seconds.
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1

# LLM rate-limit handling (defaults shown)
# After a 429 / 503 a provider is skipped for this long instead of being retried;
# a provider's own "retry in Ns" hint is used instead, capped at LLM_RETRY_HINT_MAX_SECONDS.
LLM_RATE_LIMIT_COOLDOWN_SECONDS=20
LLM_OVERLOAD_COOLDOWN_SECONDS=15
LLM_RETRY_HINT_MAX_SECONDS=30
# LLM tool proposals: time budget per proposal, and pause after this many consecutive failures.
TOOL_SELECTION_TIMEOUT_SECONDS=20
TOOL_SELECTION_MAX_CONSECUTIVE_FAILURES=2

# Environment & Deployment Safety
ENVIRONMENT=development  # development, staging, production
ALLOW_MOCK_EMBEDDINGS=false  # Set to true only for offline testing in production-like environments

# PDF Reading & Extraction Settings (Phase 4)
MAX_PDF_SIZE_BYTES=31457280  # 30 MB
PDF_DOWNLOAD_TIMEOUT=30.0
DEFAULT_EXTRACTION_METHOD=auto  # auto, pymupdf, pdfplumber

# RAG & Embedding Settings (Phase 5)
EMBEDDING_PROVIDER=mock  # gemini, mock, none
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=15.0
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=50
